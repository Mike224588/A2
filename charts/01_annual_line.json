{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Total international student enrolments and new commencements in Australia, 2019-2025, with policy annotations.",
  "width": "container",
  "height": 360,
  "data": { "url": "data/01_annual_totals.csv" },
  "layer": [
    {
      "description": "Enrolments and commencements as two lines.",
      "transform": [
        { "fold": ["enrolments", "commencements"], "as": ["series", "value"] },
        { "calculate": "datum.series == 'enrolments' ? 'Total enrolments' : 'New commencements'", "as": "Series" }
      ],
      "layer": [
        {
          "mark": { "type": "line", "interpolate": "monotone", "strokeWidth": 3 },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": null,
              "scale": { "zero": false, "nice": false },
              "axis": { "format": "d", "values": [2019, 2020, 2021, 2022, 2023, 2024, 2025], "grid": false }
            },
            "y": {
              "field": "value",
              "type": "quantitative",
              "title": "Students",
              "scale": { "domain": [0, 1200000], "zero": false, "nice": false },
              "axis": { "format": "~s", "values": [0, 200000, 400000, 600000, 800000, 1000000, 1200000] }
            },
            "color": {
              "field": "Series",
              "type": "nominal",
              "title": null,
              "scale": { "domain": ["Total enrolments", "New commencements"], "range": ["#0c4a44", "#e08a3c"] },
              "legend": { "orient": "bottom", "direction": "horizontal", "title": null }
            }
          }
        },
        {
          "mark": { "type": "point", "filled": true, "size": 55 },
          "encoding": {
            "x": { "field": "year", "type": "quantitative" },
            "y": {
              "field": "value",
              "type": "quantitative",
              "scale": { "domain": [0, 1200000], "zero": false, "nice": false }
            },
            "color": {
              "field": "Series",
              "type": "nominal",
              "scale": { "domain": ["Total enrolments", "New commencements"], "range": ["#0c4a44", "#e08a3c"] },
              "legend": null
            },
            "tooltip": [
              { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
              { "field": "Series", "type": "nominal", "title": "Measure" },
              { "field": "value", "type": "quantitative", "title": "Students", "format": "," }
            ]
          }
        }
      ]
    },
    {
      "description": "Policy annotations with room above the lines (y-axis capped at 1.2M).",
      "data": {
        "values": [
          { "year": 2020, "labelY": 980000, "label": "Borders closed" },
          { "year": 2021, "labelY": 640000, "label": "Pandemic low" },
          { "year": 2024, "labelY": 1175000, "label": "Record high" },
          { "year": 2025, "labelY": 870000, "label": "First post-COVID dip" }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "fontStyle": "italic",
        "fill": "#444"
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": {
          "field": "labelY",
          "type": "quantitative",
          "scale": { "domain": [0, 1200000], "zero": false, "nice": false }
        },
        "text": { "field": "label" }
      }
    }
  ]
}
