{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Total international student enrolments and new commencements in Australia, 2019-2025, with policy annotations.",
  "width": "container",
  "height": 360,
  "data": { "url": "data/01_annual_totals.csv" },
  "layer": [
    {
      "description": "Shaded band marking the closed-border COVID period.",
      "data": { "values": [{ "start": 2019.6, "end": 2021.4 }] },
      "mark": { "type": "rect", "fill": "#b8c4c2", "opacity": 0.18 },
      "encoding": {
        "x": { "field": "start", "type": "quantitative", "scale": { "zero": false, "nice": false } },
        "x2": { "field": "end" }
      }
    },
    {
      "description": "Enrolments and commencements as two lines.",
      "transform": [
        { "fold": ["enrolments", "commencements"], "as": ["series", "value"] },
        { "calculate": "datum.series == 'enrolments' ? 'Total enrolments' : 'New commencements'", "as": "Series" }
      ],
      "layer": [
        {
          "mark": { "type": "line", "interpolate": "monotone", "strokeWidth": 3 },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": null,
              "scale": { "zero": false, "nice": false },
              "axis": { "format": "d", "values": [2019, 2020, 2021, 2022, 2023, 2024, 2025], "grid": false }
            },
            "y": {
              "field": "value",
              "type": "quantitative",
              "title": "Students",
              "axis": { "format": "~s" }
            },
            "color": {
              "field": "Series",
              "type": "nominal",
              "title": null,
              "scale": { "domain": ["Total enrolments", "New commencements"], "range": ["#0c4a44", "#e08a3c"] },
              "legend": { "orient": "bottom", "direction": "horizontal", "title": null }
            }
          }
        },
        {
          "mark": { "type": "point", "filled": true, "size": 55 },
          "encoding": {
            "x": { "field": "year", "type": "quantitative" },
            "y": { "field": "value", "type": "quantitative" },
            "color": {
              "field": "Series",
              "type": "nominal",
              "scale": { "domain": ["Total enrolments", "New commencements"], "range": ["#0c4a44", "#e08a3c"] },
              "legend": null
            },
            "tooltip": [
              { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
              { "field": "Series", "type": "nominal", "title": "Measure" },
              { "field": "value", "type": "quantitative", "title": "Students", "format": "," }
            ]
          }
        }
      ]
    },
    {
      "description": "Annotations placed above their data points.",
      "data": {
        "values": [
          { "year": 2020, "value": 879874, "label": "Borders closed, Mar 2020" },
          { "year": 2024, "value": 1088491, "label": "Record high" },
          { "year": 2025, "value": 1056653, "label": "First post-COVID dip;caps proposed" }
        ]
      },
      "mark": { "type": "text", "align": "center", "dy": -16, "fontSize": 11, "fontStyle": "italic", "fill": "#444", "lineBreak": ";" },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": { "field": "value", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },
    {
      "description": "Annotation placed below the pandemic low.",
      "data": { "values": [{ "year": 2021, "value": 715792, "label": "Pandemic low" }] },
      "mark": { "type": "text", "align": "center", "dy": 24, "fontSize": 11, "fontStyle": "italic", "fill": "#444" },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": { "field": "value", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}
