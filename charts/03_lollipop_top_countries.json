{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 source countries of international students in Australia, 2025, shown as a lollipop chart.",
  "width": "container",
  "height": 300,
  "data": { "url": "data/04b_top20_nationalities_2025.csv" },
  "transform": [
    {
      "window": [
        { "op": "rank", "sort": [{ "field": "enrolments", "order": "descending" }], "as": "rank" }
      ]
    },
    { "filter": "datum.rank <= 10" }
  ],
  "encoding": {
    "y": {
      "field": "nationality",
      "type": "nominal",
      "sort": { "field": "rank", "order": "ascending" },
      "title": null,
      "axis": { "labelFontSize": 12 }
    }
  },
  "layer": [
    {
      "mark": { "type": "rule", "color": "#9ad1cb", "strokeWidth": 2.5 },
      "encoding": {
        "x": {
          "field": "enrolments",
          "type": "quantitative",
          "title": "Enrolments in 2025",
          "scale": { "domain": [0, 270000] },
          "axis": { "format": "~s", "grid": false, "values": [0, 50000, 100000, 150000, 200000, 250000] }
        },
        "x2": { "datum": 0 }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 95, "color": "#0c4a44" },
      "encoding": {
        "x": { "field": "enrolments", "type": "quantitative" },
        "tooltip": [
          { "field": "nationality", "type": "nominal", "title": "Country" },
          { "field": "enrolments", "type": "quantitative", "title": "Enrolments", "format": "," }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 9, "fontSize": 10.5, "fill": "#555" },
      "encoding": {
        "x": { "field": "enrolments", "type": "quantitative" },
        "text": { "field": "enrolments", "type": "quantitative", "format": "," }
      }
    }
  ]
}
